<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:home="clr-namespace:NdiForAndroid.Features.Home.Views"
       xmlns:sources="clr-namespace:NdiForAndroid.Features.Sources.Views"
       xmlns:viewer="clr-namespace:NdiForAndroid.Features.Viewer.Views"
       xmlns:output="clr-namespace:NdiForAndroid.Features.Output.Views"
       xmlns:settings="clr-namespace:NdiForAndroid.Features.Settings.Views"
       xmlns:t="clr-namespace:NdiForAndroid.Testing;assembly=NdiForAndroid.Core"
       x:Class="NdiForAndroid.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.FlyoutWidth="72"
       Shell.FlyoutBackgroundColor="{DynamicResource ShellBackground}"
       Shell.TabBarBackgroundColor="{DynamicResource ShellBackground}"
       Shell.TabBarForegroundColor="{DynamicResource ShellTabSelected}"
       Shell.TabBarTitleColor="{DynamicResource ShellTabSelected}"
       Shell.TabBarUnselectedColor="{DynamicResource ShellTabUnselected}"
       Title="NDI for Android">

    <!-- Custom left navigation rail. FlyoutHeaderTemplate intentionally omitted:
         setting it alongside FlyoutContent triggers a MAUI compat renderer NRE.
         RailItems.Padding is set in code-behind from the real status-bar inset (#296) —
         the window is drawn edge-to-edge, so a literal top padding would sit under the clock. -->
    <Shell.FlyoutContent>
        <Grid BackgroundColor="{DynamicResource ShellBackground}" WidthRequest="64">
            <VerticalStackLayout x:Name="RailItems"
                                 VerticalOptions="Start"
                                 Spacing="0" />
        </Grid>
    </Shell.FlyoutContent>

    <FlyoutItem x:Name="HomeRailItem"
                Route="home-rail-item"
                Shell.FlyoutItemIsVisible="False">
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate home:HomePage}"
                      Route="home-rail"
                      Icon="nav_home.svg" />
    </FlyoutItem>

    <FlyoutItem x:Name="StreamRailItem"
                Route="stream-rail-item"
                Shell.FlyoutItemIsVisible="False">
        <ShellContent Title="Stream"
                      ContentTemplate="{DataTemplate output:OutputPage}"
                      Route="stream-rail"
                      Icon="nav_stream.svg" />
    </FlyoutItem>

    <FlyoutItem x:Name="ViewRailItem"
                Route="view-rail-item"
                Shell.FlyoutItemIsVisible="False">
        <ShellContent Title="View"
                      ContentTemplate="{DataTemplate sources:SourceListPage}"
                      Route="view-rail"
                      Icon="nav_view.svg" />
    </FlyoutItem>

    <FlyoutItem x:Name="SettingsRailItem"
                Route="settings-rail-item"
                Shell.FlyoutItemIsVisible="False">
        <ShellContent Title="Settings"
                      ContentTemplate="{DataTemplate settings:SettingsPage}"
                      Route="settings-rail"
                      Icon="nav_settings.svg" />
    </FlyoutItem>

    <!-- AutomationId on ShellContent is best-effort: Shell renders the bottom bar with a native
         BottomNavigationView, which does not reliably carry the id through to the tab's
         resource-id. The rail sets the same id on its own Border, where it does stick. Tests
         locate navigation by id and fall back to the accessibility label for exactly this
         reason — see NavigationBar in the page objects. -->
    <TabBar x:Name="PrimaryTabBar">
        <ShellContent Title="Home"
                      AutomationId="{x:Static t:TestIds.NavHome}"
                      ContentTemplate="{DataTemplate home:HomePage}"
                      Route="home-tab"
                      Icon="nav_home.svg" />
        <ShellContent Title="Stream"
                      AutomationId="{x:Static t:TestIds.NavStream}"
                      ContentTemplate="{DataTemplate output:OutputPage}"
                      Route="stream-tab"
                      Icon="nav_stream.svg" />
        <ShellContent Title="View"
                      AutomationId="{x:Static t:TestIds.NavView}"
                      ContentTemplate="{DataTemplate sources:SourceListPage}"
                      Route="view-tab"
                      Icon="nav_view.svg" />
        <ShellContent Title="Settings"
                      AutomationId="{x:Static t:TestIds.NavSettings}"
                      ContentTemplate="{DataTemplate settings:SettingsPage}"
                      Route="settings-tab"
                      Icon="nav_settings.svg" />
    </TabBar>

</Shell>
