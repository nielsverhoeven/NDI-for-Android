<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral monochrome status-bar icon for the NDI output foreground notification (#370
     home-nav-06). A status-bar small icon must be a plain white silhouette on a transparent
     background — Android tints it itself — so this intentionally has no colour of its own; it
     replaces the OS "warning triangle" (Android.Resource.Drawable.StatSysWarning), which read as
     an error/alert rather than "output is running". Three concentric arcs read as a broadcast/
     signal glyph at 24dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="24dp"
        android:height="24dp"
        android:viewportWidth="24"
        android:viewportHeight="24"
        android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,15.5c-0.83,0 -1.5,0.67 -1.5,1.5s0.67,1.5 1.5,1.5 1.5,-0.67 1.5,-1.5 -0.67,-1.5 -1.5,-1.5z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M8.46,13.46c0.94,-0.94 2.22,-1.46 3.54,-1.46s2.6,0.52 3.54,1.46" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M5.64,10.64c1.68,-1.68 3.97,-2.64 6.36,-2.64s4.68,0.96 6.36,2.64" />
</vector>
