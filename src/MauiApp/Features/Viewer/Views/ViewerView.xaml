<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:vm="clr-namespace:NdiForAndroid.Features.Viewer.ViewModels;assembly=NdiForAndroid.Core"
             xmlns:t="clr-namespace:NdiForAndroid.Testing;assembly=NdiForAndroid.Core"
             xmlns:views="clr-namespace:NdiForAndroid.Features.Viewer.Views"
             x:Class="NdiForAndroid.Features.Viewer.Views.ViewerView"
             x:DataType="vm:ViewerViewModel">
    <Grid RowDefinitions="Auto,*">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Padding" Value="16" />
                <Setter Property="RowSpacing" Value="16" />
                <Style.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsFullScreen}" Value="True">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="RowSpacing" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!-- Video surface. Border turns red while the source echoes program tally. -->
        <Border Grid.Row="0"
                AutomationId="{x:Static t:TestIds.ViewerVideoBorder}"
                StrokeThickness="3"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{DynamicResource Black}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                    <Style.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsTallyProgram}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource ErrorRed}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsFullScreen}" Value="True">
                            <Setter Property="Grid.RowSpan" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.GestureRecognizers>
                <TapGestureRecognizer NumberOfTapsRequired="1" Command="{Binding ShowControlsOverlayCommand}" />
                <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding ToggleFullScreenCommand}" />
            </Border.GestureRecognizers>
            <Grid>
                <!-- ~16:9 video area; frames are letterboxed by the paint handler. -->
                <skia:SKCanvasView x:Name="VideoCanvas"
                                   AutomationId="{x:Static t:TestIds.ViewerVideoCanvas}"
                                   VerticalOptions="Fill" HorizontalOptions="Fill" />

                <!-- Program-tally badge (#350): redundant text + shape cue, bound to the same
                     IsTallyProgram as the red stroke, so the state is never colour-only
                     (WCAG 1.4.1). Lives inside the video surface so it shows in Deck, Sheet and
                     full screen alike; top-right because the full-screen overlay uses the other
                     three corners. InputTransparent keeps single/double taps flowing to the
                     outer Border's gestures. -->
                <Border AutomationId="{x:Static t:TestIds.ViewerTallyProgramBadge}"
                        IsVisible="{Binding IsTallyProgram}"
                        InputTransparent="True"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="8"
                        Padding="10,4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{DynamicResource ErrorFill}">
                    <Label Text="ON PROGRAM"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           LineBreakMode="NoWrap"
                           VerticalOptions="Center"
                           TextColor="{DynamicResource OnPrimary}"
                           SemanticProperties.Description="On program" />
                </Border>
            </Grid>
        </Border>

        <views:ViewerControlDeck x:Name="Deck" Grid.Row="1" />
        <views:ViewerControlSheet x:Name="Sheet" Grid.RowSpan="2" />
        <views:FullScreenControlsOverlay x:Name="Overlay" Grid.RowSpan="2" />

        <views:PtzEndpointPanel Grid.RowSpan="2" />
    </Grid>
</ContentView>
