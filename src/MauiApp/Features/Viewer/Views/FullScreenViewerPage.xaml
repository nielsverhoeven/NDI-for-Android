<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:NdiForAndroid.Features.Viewer.Views"
             xmlns:vm="clr-namespace:NdiForAndroid.Features.Viewer.ViewModels;assembly=NdiForAndroid.Core"
             x:Class="NdiForAndroid.Features.Viewer.Views.FullScreenViewerPage"
             x:DataType="vm:ViewerViewModel"
             BackgroundColor="Black">
    <!-- Chromeless by construction: a modally-pushed ContentPage has no Shell nav/tab bar.
         Hosts the same ViewerViewModel as the donor page/pane via a second ViewerView. -->
    <views:ViewerView x:Name="FullScreenViewer" IsModalHost="True" />
</ContentPage>
