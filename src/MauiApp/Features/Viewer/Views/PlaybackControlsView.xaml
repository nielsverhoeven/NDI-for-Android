<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NdiForAndroid.Features.Viewer.ViewModels;assembly=NdiForAndroid.Core"
             xmlns:models="clr-namespace:NdiForAndroid.Features.Viewer.Models;assembly=NdiForAndroid.Core"
             xmlns:t="clr-namespace:NdiForAndroid.Testing;assembly=NdiForAndroid.Core"
             x:Class="NdiForAndroid.Features.Viewer.Views.PlaybackControlsView"
             x:DataType="vm:ViewerViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding StatusMessage}" FontSize="13"
                       AutomationId="{x:Static t:TestIds.ViewerStatus}"
                       LineBreakMode="TailTruncation" TextColor="{DynamicResource TextPrimary}" />
                <!-- Active profile + advisory connection hint (#330/#331). Collapses while idle. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsPlaying}">
                    <Label Grid.Column="0" Text="{Binding QualityProfileLabel}" FontSize="12"
                           AutomationId="{x:Static t:TestIds.ViewerQualityLabel}"
                           TextColor="{DynamicResource TextSecondary}"
                           IsVisible="{Binding QualityProfileLabel, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Grid.Column="1" Text="{Binding ConnectionHint}" FontSize="12" FontAttributes="Bold"
                           AutomationId="{x:Static t:TestIds.ViewerConnectionHint}"
                           TextColor="{DynamicResource WarningText}" LineBreakMode="TailTruncation"
                           IsVisible="{Binding ConnectionHint, Converter={StaticResource IsNotNullConverter}}" />
                </Grid>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="PTZ endpoint…" FontSize="12" Padding="10,0"
                    HeightRequest="48" VerticalOptions="Center"
                    BackgroundColor="{DynamicResource CardBackground}"
                    TextColor="{DynamicResource TextPrimary}"
                    Command="{Binding OpenPtzEndpointFormCommand}"
                    IsVisible="{Binding IsPtzControlActive, Converter={StaticResource InverseBoolConverter}}" />
        </Grid>

        <Grid Grid.Row="1">
            <!-- Quality strip generated from AvailableProfiles: one Button per QualityProfile enum
                 value. FlexLayout (Grow=1, Basis=0) gives equal widths like the old *,*,* Grid. -->
            <FlexLayout Direction="Row" Wrap="NoWrap" JustifyContent="SpaceBetween" AlignItems="Stretch"
                        HeightRequest="48" MinimumHeightRequest="48"
                        BindableLayout.ItemsSource="{Binding AvailableProfiles}">
                <FlexLayout.Style>
                    <Style TargetType="FlexLayout">
                        <Setter Property="IsVisible" Value="{Binding IsPlaying}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="FlexLayout" Binding="{Binding IsReconnecting}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </FlexLayout.Style>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:QualityProfileOption">
                        <Button Text="{Binding Label}" Padding="4,0" Margin="2,0"
                                HeightRequest="48" MinimumHeightRequest="48"
                                FlexLayout.Grow="1" FlexLayout.Basis="0"
                                AutomationId="{Binding AutomationId}"
                                SemanticProperties.Description="{Binding Description}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ViewerViewModel}}, Path=ChangeQualityProfileCommand}"
                                CommandParameter="{Binding Profile}">
                            <Button.Triggers>
                                <!-- Default Button style (Primary / OnPrimary) = selected; unselected goes flat. -->
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsReconnecting}">
                <ActivityIndicator IsRunning="{Binding IsReconnecting}" Color="{DynamicResource TextPrimary}"
                                   WidthRequest="20" HeightRequest="20" />
                <Label Text="{Binding RetryStatusMessage}" VerticalOptions="Center" FontSize="12"
                       AutomationId="{x:Static t:TestIds.ViewerRetryStatus}" />
                <Button Text="Cancel" Command="{Binding CancelRetryCommand}" HeightRequest="48" FontSize="12" Padding="10,4"
                        AutomationId="{x:Static t:TestIds.ViewerCancelRetry}" />
            </HorizontalStackLayout>

            <Button Text="Reconnect" Command="{Binding ReconnectCommand}"
                    AutomationId="{x:Static t:TestIds.ViewerReconnect}"
                    IsVisible="{Binding CanReconnect}" HeightRequest="48" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="48,48,*" ColumnSpacing="6" HeightRequest="48" MinimumHeightRequest="48"
              IsVisible="{Binding IsPlaying}">
            <Switch Grid.Column="0" IsToggled="{Binding IsAudioEnabled}"
                    AutomationId="{x:Static t:TestIds.ViewerAudioToggle}"
                    WidthRequest="48" HeightRequest="48" MinimumHeightRequest="48" HorizontalOptions="Center"
                    SemanticProperties.Description="Audio" />
            <Button Grid.Column="1" Text="⛶" Command="{Binding ToggleFullScreenCommand}"
                    WidthRequest="48" HeightRequest="48" MinimumHeightRequest="48" Padding="0"
                    SemanticProperties.Description="Toggle full screen">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsFullScreen}" Value="True">
                        <Setter Property="Text" Value="⤢" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2" Text="Stop" Command="{Binding StopCommand}"
                    AutomationId="{x:Static t:TestIds.ViewerStop}"
                    HorizontalOptions="Fill" HeightRequest="48" MinimumHeightRequest="48"
                    BackgroundColor="{DynamicResource ErrorFill}" TextColor="{DynamicResource OnPrimary}" />
        </Grid>
    </Grid>
</ContentView>
