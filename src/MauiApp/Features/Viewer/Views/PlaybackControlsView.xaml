<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NdiForAndroid.Features.Viewer.ViewModels;assembly=NdiForAndroid.Core"
             x:Class="NdiForAndroid.Features.Viewer.Views.PlaybackControlsView"
             x:DataType="vm:ViewerViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13"
                   LineBreakMode="TailTruncation" TextColor="{DynamicResource TextPrimary}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1" Text="PTZ endpoint…" FontSize="12" Padding="10,0"
                    HeightRequest="48" VerticalOptions="Center"
                    BackgroundColor="{DynamicResource CardBackground}"
                    TextColor="{DynamicResource TextPrimary}"
                    Command="{Binding OpenPtzEndpointFormCommand}"
                    IsVisible="{Binding IsPtzControlActive, Converter={StaticResource InverseBoolConverter}}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" HeightRequest="40">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="IsVisible" Value="{Binding IsPlaying}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsReconnecting}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Button Grid.Column="0" Text="Smooth" Padding="4,0"
                        Command="{Binding ChangeQualityProfileCommand}" CommandParameter="Smooth">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding QualityProfile}" Value="Balanced">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding QualityProfile}" Value="High">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Balanced" Padding="4,0"
                        Command="{Binding ChangeQualityProfileCommand}" CommandParameter="Balanced">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding QualityProfile}" Value="Smooth">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding QualityProfile}" Value="High">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="High" Padding="4,0"
                        Command="{Binding ChangeQualityProfileCommand}" CommandParameter="High">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding QualityProfile}" Value="Smooth">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding QualityProfile}" Value="Balanced">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsReconnecting}">
                <ActivityIndicator IsRunning="{Binding IsReconnecting}" Color="{DynamicResource TextPrimary}"
                                   WidthRequest="20" HeightRequest="20" />
                <Label Text="{Binding RetryStatusMessage}" VerticalOptions="Center" FontSize="12" />
                <Button Text="Cancel" Command="{Binding CancelRetryCommand}" HeightRequest="32" FontSize="12" Padding="10,4" />
            </HorizontalStackLayout>

            <Button Text="Reconnect" Command="{Binding ReconnectCommand}"
                    IsVisible="{Binding CanReconnect}" HeightRequest="40" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="48,48,*" ColumnSpacing="6" HeightRequest="48"
              IsVisible="{Binding IsPlaying}">
            <Switch Grid.Column="0" IsToggled="{Binding IsAudioEnabled}"
                    WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" />
            <Button Grid.Column="1" Text="⛶" Command="{Binding ToggleFullScreenCommand}"
                    WidthRequest="48" HeightRequest="48" Padding="0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsFullScreen}" Value="True">
                        <Setter Property="Text" Value="⤢" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2" Text="Stop" Command="{Binding StopCommand}"
                    HorizontalOptions="Fill" HeightRequest="48"
                    BackgroundColor="{DynamicResource ErrorRed}" TextColor="{DynamicResource White}" />
        </Grid>
    </Grid>
</ContentView>
