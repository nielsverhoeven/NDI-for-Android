<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NdiForAndroid.Features.Settings.ViewModels;assembly=NdiForAndroid.Core"
             xmlns:model="clr-namespace:NdiForAndroid.Features.Settings.Models;assembly=NdiForAndroid.Core"
             xmlns:t="clr-namespace:NdiForAndroid.Testing;assembly=NdiForAndroid.Core"
             x:Class="NdiForAndroid.Features.Settings.Views.SettingsPage"
             x:Name="SettingsRoot"
             x:DataType="vm:SettingsViewModel"
             AutomationId="{x:Static t:TestIds.SettingsPage}"
             Title="Settings">
    <Grid>
        <ScrollView>
              <!-- Medium/Expanded: 220dp vertical rail beside the panel (RailColumn width 220,
                   VerticalRail visible). Compact: RailColumn collapses to 0 and the same five
                   section buttons render as a horizontal, scrollable selector in CompactRail
                   above the panel instead — a fixed 220dp rail leaves too little width for the
                   detail panel on a phone. SettingsPage.xaml.cs's OnSizeAllocated toggles between
                   the two; both button sets share their AutomationIds, the same pattern already
                   used for the bottom tab bar vs. the landscape nav rail. -->
              <Grid x:Name="SectionsGrid" Padding="16" RowSpacing="12" ColumnSpacing="16">
                     <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                     </Grid.RowDefinitions>
                     <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="RailColumn" Width="220" />
                            <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>

                     <ScrollView x:Name="CompactRail" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Orientation="Horizontal" IsVisible="False">
                            <HorizontalStackLayout Spacing="10">
                                   <Button Text="General"
                                          AutomationId="{x:Static t:TestIds.SettingsSectionGeneral}"
                                                 Command="{Binding SelectSectionCommand}"
                                          CommandParameter="{x:Static vm:SettingsSection.General}" />
                                   <Button Text="Appearance"
                                          AutomationId="{x:Static t:TestIds.SettingsSectionAppearance}"
                                                 Command="{Binding SelectSectionCommand}"
                                          CommandParameter="{x:Static vm:SettingsSection.Appearance}" />
                                   <Button Text="Discovery"
                                          AutomationId="{x:Static t:TestIds.SettingsSectionDiscovery}"
                                                 Command="{Binding SelectSectionCommand}"
                                          CommandParameter="{x:Static vm:SettingsSection.Discovery}" />
                                   <Button Text="Developer tools"
                                          AutomationId="{x:Static t:TestIds.SettingsSectionDeveloperTools}"
                                                 Command="{Binding SelectSectionCommand}"
                                          CommandParameter="{x:Static vm:SettingsSection.DeveloperTools}" />
                                   <Button Text="About"
                                          AutomationId="{x:Static t:TestIds.SettingsSectionAbout}"
                                                 Command="{Binding SelectSectionCommand}"
                                          CommandParameter="{x:Static vm:SettingsSection.About}" />
                            </HorizontalStackLayout>
                     </ScrollView>

                     <VerticalStackLayout x:Name="VerticalRail" Grid.Row="1" Grid.Column="0" Spacing="10">
                            <Button Text="General"
                                   AutomationId="{x:Static t:TestIds.SettingsSectionGeneral}"
                                          Command="{Binding SelectSectionCommand}"
                                   CommandParameter="{x:Static vm:SettingsSection.General}" />
                            <Button Text="Appearance"
                                   AutomationId="{x:Static t:TestIds.SettingsSectionAppearance}"
                                          Command="{Binding SelectSectionCommand}"
                                   CommandParameter="{x:Static vm:SettingsSection.Appearance}" />
                            <Button Text="Discovery"
                                   AutomationId="{x:Static t:TestIds.SettingsSectionDiscovery}"
                                          Command="{Binding SelectSectionCommand}"
                                   CommandParameter="{x:Static vm:SettingsSection.Discovery}" />
                            <Button Text="Developer tools"
                                   AutomationId="{x:Static t:TestIds.SettingsSectionDeveloperTools}"
                                          Command="{Binding SelectSectionCommand}"
                                   CommandParameter="{x:Static vm:SettingsSection.DeveloperTools}" />
                            <Button Text="About"
                                   AutomationId="{x:Static t:TestIds.SettingsSectionAbout}"
                                          Command="{Binding SelectSectionCommand}"
                                   CommandParameter="{x:Static vm:SettingsSection.About}" />
                     </VerticalStackLayout>

                     <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="12">
                            <VerticalStackLayout AutomationId="{x:Static t:TestIds.SettingsPanelGeneral}" IsVisible="{Binding IsGeneralSectionSelected}" Spacing="8">
                                   <Label Text="General Settings" FontAttributes="Bold" FontSize="20" />
                                   <Label Text="{Binding GeneralGuidanceText}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout AutomationId="{x:Static t:TestIds.SettingsPanelAppearance}" IsVisible="{Binding IsAppearanceSectionSelected}" Spacing="10">
                                   <Label Text="Appearance Settings" FontAttributes="Bold" FontSize="20" />

                                   <Label Text="Theme" FontAttributes="Bold" />
                                   <VerticalStackLayout Spacing="4"
                                                                       RadioButtonGroup.GroupName="ThemeMode"
                                                                       RadioButtonGroup.SelectedValue="{Binding SelectedThemeOption}">
                                          <RadioButton Content="Light" Value="Light" AutomationId="{x:Static t:TestIds.SettingsThemeLight}" />
                                          <RadioButton Content="Dark" Value="Dark" AutomationId="{x:Static t:TestIds.SettingsThemeDark}" />
                                          <RadioButton Content="System default" Value="System default" AutomationId="{x:Static t:TestIds.SettingsThemeSystem}" />
                                   </VerticalStackLayout>

                                   <Label Text="Accent color" FontAttributes="Bold" />
                                   <FlexLayout Wrap="Wrap"
                                                        Direction="Row"
                                                        JustifyContent="Start"
                                                        AlignItems="Center"
                                                        RadioButtonGroup.GroupName="AccentColor"
                                                        RadioButtonGroup.SelectedValue="{Binding SelectedAccentColor}">
                                          <RadioButton Content="Blue" Value="Blue" Margin="0,0,16,0" AutomationId="{x:Static t:TestIds.SettingsAccentBlue}" />
                                          <RadioButton Content="Teal" Value="Teal" Margin="0,0,16,0" AutomationId="{x:Static t:TestIds.SettingsAccentTeal}" />
                                          <RadioButton Content="Green" Value="Green" Margin="0,0,16,0" AutomationId="{x:Static t:TestIds.SettingsAccentGreen}" />
                                          <RadioButton Content="Orange" Value="Orange" Margin="0,0,16,0" AutomationId="{x:Static t:TestIds.SettingsAccentOrange}" />
                                          <RadioButton Content="Red" Value="Red" Margin="0,0,16,0" AutomationId="{x:Static t:TestIds.SettingsAccentRed}" />
                                          <RadioButton Content="Pink" Value="Pink" Margin="0,0,16,0" AutomationId="{x:Static t:TestIds.SettingsAccentPink}" />
                                   </FlexLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout AutomationId="{x:Static t:TestIds.SettingsPanelDiscovery}" IsVisible="{Binding IsDiscoverySectionSelected}" Spacing="10">
                                   <Label Text="Discovery Settings" FontAttributes="Bold" FontSize="20" />

                                   <Label Text="Add discovery server" FontAttributes="Bold" />
                                   <Entry Placeholder="Display name (optional)"
                                             Text="{Binding NewServerDisplayName}" />
                                   <Entry Placeholder="Hostname or IP"
                                             AutomationId="{x:Static t:TestIds.SettingsDiscoveryHost}"
                                             Text="{Binding NewServerHost}"
                                             Keyboard="Url" />
                                   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                          <Entry Grid.Column="0"
                                                    AutomationId="{x:Static t:TestIds.SettingsDiscoveryPort}"
                                                    Placeholder="Port (default 5959)"
                                                    Text="{Binding NewServerPort}"
                                                    Keyboard="Numeric" />
                                          <Button Grid.Column="1"
                                                        AutomationId="{x:Static t:TestIds.SettingsDiscoveryServerAction}"
                                                        Text="Add Server"
                                                        Command="{Binding AddDiscoveryServerCommand}" />
                                   </Grid>

                                   <Label Text="{Binding DiscoveryServersValidationMessage}"
                                             AutomationId="{x:Static t:TestIds.SettingsDiscoveryServersError}"
                                             TextColor="{DynamicResource ErrorRed}" />

                                   <CollectionView AutomationId="{x:Static t:TestIds.SettingsDiscoveryServerList}" ItemsSource="{Binding DiscoveryServers}">
                                          <CollectionView.ItemTemplate>
                                                 <DataTemplate x:DataType="vm:DiscoveryServerItem">
                                                        <!-- Two rows: identity, then actions. A single seven-column row does not
                                                             fit a Switch plus four >=48dp action buttons in the detail panel's
                                                             width at Compact. -->
                                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8" RowSpacing="6" Padding="0,6">
                                                               <Label Grid.Row="0" Grid.Column="0"
                                                                          Text="●"
                                                                          FontSize="18"
                                                                          VerticalOptions="Center"
                                                                          TextColor="{Binding ConnectionState, Converter={StaticResource DiscoveryServerStateColorConverter}}" />
                                                               <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                                      <Label Text="{Binding NameDisplay}" FontAttributes="Bold" />
                                                                      <HorizontalStackLayout Spacing="8">
                                                                             <Label Text="{Binding EndpointDisplay}"
                                                                                       AutomationId="{x:Static t:TestIds.SettingsServerRowEndpoint}"
                                                                                       FontSize="12"
                                                                                       TextColor="{DynamicResource TextSecondary}" />
                                                                             <Label Text="{Binding ConnectionStateDisplay}"
                                                                                       FontSize="12"
                                                                                       TextColor="{DynamicResource TextSecondary}" />
                                                                      </HorizontalStackLayout>
                                                               </VerticalStackLayout>
                                                               <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                                                                      <Switch IsToggled="{Binding Enabled}" AutomationId="{x:Static t:TestIds.SettingsServerRowEnabled}" VerticalOptions="Center" />
                                                                      <Button Text="▲"
                                                                                    WidthRequest="48" HeightRequest="48" Padding="0"
                                                                                    AutomationId="{x:Static t:TestIds.SettingsServerRowUp}"
                                                                                    Command="{Binding Source={x:Reference SettingsRoot}, Path=BindingContext.MoveDiscoveryServerUpCommand}"
                                                                                    CommandParameter="{Binding .}" />
                                                                      <Button Text="▼"
                                                                                    WidthRequest="48" HeightRequest="48" Padding="0"
                                                                                    AutomationId="{x:Static t:TestIds.SettingsServerRowDown}"
                                                                                    Command="{Binding Source={x:Reference SettingsRoot}, Path=BindingContext.MoveDiscoveryServerDownCommand}"
                                                                                    CommandParameter="{Binding .}" />
                                                                      <Button Text="✎"
                                                                                    WidthRequest="48" HeightRequest="48" Padding="0"
                                                                                    AutomationId="{x:Static t:TestIds.SettingsServerRowEdit}"
                                                                                    Command="{Binding Source={x:Reference SettingsRoot}, Path=BindingContext.EditDiscoveryServerCommand}"
                                                                                    CommandParameter="{Binding .}" />
                                                                      <Button Text="✕"
                                                                                    WidthRequest="48" HeightRequest="48" Padding="0"
                                                                                    AutomationId="{x:Static t:TestIds.SettingsServerRowDelete}"
                                                                                    Command="{Binding Source={x:Reference SettingsRoot}, Path=BindingContext.RemoveDiscoveryServerCommand}"
                                                                                    CommandParameter="{Binding .}" />
                                                               </HorizontalStackLayout>
                                                        </Grid>
                                                 </DataTemplate>
                                          </CollectionView.ItemTemplate>
                                   </CollectionView>
                            </VerticalStackLayout>

                            <VerticalStackLayout AutomationId="{x:Static t:TestIds.SettingsPanelDeveloperTools}" IsVisible="{Binding IsDeveloperToolsSectionSelected}" Spacing="10">
                                   <Label Text="Developer Settings" FontAttributes="Bold" FontSize="20" />

                                   <HorizontalStackLayout Spacing="8">
                                          <Switch IsToggled="{Binding DeveloperModeEnabled}" AutomationId="{x:Static t:TestIds.SettingsDeveloperModeToggle}" />
                                          <Label Text="Developer Mode" VerticalOptions="Center" />
                                   </HorizontalStackLayout>

                                   <Label Text="Cached Source Registry" FontAttributes="Bold" />
                                   <CollectionView AutomationId="{x:Static t:TestIds.SettingsCachedSourceList}" ItemsSource="{Binding CachedSourceRegistry}">
                                          <CollectionView.ItemTemplate>
                                                 <DataTemplate x:DataType="model:CachedSourceRegistryEntry">
                                                        <VerticalStackLayout Spacing="2" Padding="0,6">
                                                               <Label Text="{Binding SourceName}" FontAttributes="Bold" />
                                                               <Label Text="{Binding Endpoint, StringFormat='Endpoint: {0}'}" />
                                                               <Label Text="{Binding State, StringFormat='State: {0}'}" />
                                                               <Label Text="{Binding RegistryKey, StringFormat='Key: {0}'}" />
                                                               <Label Text="{Binding LastSeenDisplay, StringFormat='Last seen: {0}'}" />
                                                        </VerticalStackLayout>
                                                 </DataTemplate>
                                          </CollectionView.ItemTemplate>
                                   </CollectionView>
                            </VerticalStackLayout>

                            <VerticalStackLayout AutomationId="{x:Static t:TestIds.SettingsPanelAbout}" IsVisible="{Binding IsAboutSectionSelected}" Spacing="8">
                                   <Label Text="About" FontAttributes="Bold" FontSize="20" />
                                   <Label Text="{Binding AppName}" AutomationId="{x:Static t:TestIds.SettingsAppName}" FontAttributes="Bold" />
                                   <Label Text="{Binding AppVersionBuild}" AutomationId="{x:Static t:TestIds.SettingsAppVersion}" />
                                   <Label Text="{Binding NdiSdkVersion}" AutomationId="{x:Static t:TestIds.SettingsNdiSdkVersion}" TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>
                     </VerticalStackLayout>
              </Grid>
        </ScrollView>

        <!-- Edit-server modal overlay (#292): dialog over a dimmed scrim; state lives in the ViewModel. -->
        <Grid IsVisible="{Binding IsEditServerDialogOpen}"
                 BackgroundColor="{DynamicResource ScrimBackground}">
               <Border BackgroundColor="{DynamicResource CardBackground}"
                          Stroke="{DynamicResource BorderColor}"
                          StrokeShape="RoundRectangle 12"
                          Padding="20"
                          WidthRequest="420"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                      <VerticalStackLayout Spacing="10">
                             <Label Text="Edit discovery server" FontAttributes="Bold" FontSize="18" />
                             <Entry Placeholder="Display name (optional)"
                                       Text="{Binding EditServerDisplayName}" />
                             <Entry Placeholder="Hostname or IP"
                                       Text="{Binding EditServerHost}"
                                       Keyboard="Url" />
                             <Entry Placeholder="Port (default 5959)"
                                       Text="{Binding EditServerPort}"
                                       Keyboard="Numeric" />
                             <Label Text="{Binding EditServerValidationMessage}"
                                       TextColor="{DynamicResource ErrorRed}" />
                             <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                    <Button Text="Cancel" Command="{Binding CancelEditDiscoveryServerCommand}" />
                                    <Button Text="Save" Command="{Binding SaveEditedDiscoveryServerCommand}" />
                             </HorizontalStackLayout>
                      </VerticalStackLayout>
               </Border>
        </Grid>
    </Grid>
</ContentPage>
