<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NdiForAndroid.Features.DiagOverlay.ViewModels;assembly=NdiForAndroid.Core"
             xmlns:t="clr-namespace:NdiForAndroid.Testing;assembly=NdiForAndroid.Core"
             x:Class="NdiForAndroid.Features.DiagOverlay.Views.DiagnosticLogPage"
             x:DataType="vm:DiagnosticLogViewModel"
             AutomationId="{x:Static t:TestIds.DiagnosticLogPage}"
             Title="Diagnostic Log">
    <!-- Grid, not VerticalStackLayout: a CollectionView in a stack layout is measured with
         unbounded height and never scrolls (#437). -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="8">
        <Label Grid.Row="0" Text="In-memory diagnostic log (last 200 entries)" FontAttributes="Bold" />

        <CollectionView Grid.Row="1"
                        AutomationId="{x:Static t:TestIds.DiagnosticLogList}"
                        ItemsSource="{Binding LogEntries}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No entries yet."
                       TextColor="{DynamicResource TextSecondary}"
                       HorizontalOptions="Center"
                       Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogEntryViewModel">
                    <Border Padding="8"
                            Margin="0,2"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource CardBackground}"
                            Stroke="{DynamicResource BorderColor}">
                        <!-- The message gets its own full-width row and wraps: on a phone the old
                             single-row layout truncated it after a few characters. -->
                        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                            <Label Grid.Column="0"
                                   Text="{Binding LevelLabel}"
                                   AutomationId="{x:Static t:TestIds.DiagnosticLogRowLevel}"
                                   TextColor="{Binding Level, Converter={StaticResource LogLevelColorConverter}}"
                                   FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                   Text="{Binding TimestampRelative}"
                                   AutomationId="{x:Static t:TestIds.DiagnosticLogRowTime}"
                                   Opacity="0.7" />
                            <Label Grid.Column="2" Text="{Binding Category}" FontAttributes="Bold" />
                            <Label Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding Message}"
                                   AutomationId="{x:Static t:TestIds.DiagnosticLogRowText}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Clear Log"
                Command="{Binding ClearCommand}"
                AutomationId="{x:Static t:TestIds.DiagnosticLogClear}"
                MinimumHeightRequest="48"
                HorizontalOptions="Center" />
    </Grid>
</ContentPage>
