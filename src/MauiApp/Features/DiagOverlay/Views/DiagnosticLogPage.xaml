<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NdiForAndroid.Features.DiagOverlay.ViewModels;assembly=NdiForAndroid.Core"
             xmlns:t="clr-namespace:NdiForAndroid.Testing;assembly=NdiForAndroid.Core"
             x:Class="NdiForAndroid.Features.DiagOverlay.Views.DiagnosticLogPage"
             x:DataType="vm:DiagnosticLogViewModel"
             AutomationId="{x:Static t:TestIds.DiagnosticLogPage}"
             Title="Diagnostic Log">
    <VerticalStackLayout Padding="16" Spacing="8">
        <Label Text="In-Memory Diagnostic Log Buffer (last 200 entries)" FontAttributes="Bold" />

        <CollectionView AutomationId="{x:Static t:TestIds.DiagnosticLogList}"
                        ItemsSource="{Binding LogEntries}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogEntryViewModel">
                    <Frame Padding="8" Margin="0,2">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding Level, StringFormat='[{{0}}]'}" AutomationId="{x:Static t:TestIds.DiagnosticLogRowLevel}" WidthRequest="70" TextColor="{Binding LevelColor}" FontAttributes="Bold" />
                            <Label Text="{Binding TimestampRelative}" AutomationId="{x:Static t:TestIds.DiagnosticLogRowTime}" WidthRequest="80" Opacity="0.7" />
                            <Label Text="{Binding Message}" AutomationId="{x:Static t:TestIds.DiagnosticLogRowText}" LineBreakMode="TailTruncation" />
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Clear Log" Command="{Binding ClearCommand}"
                AutomationId="{x:Static t:TestIds.DiagnosticLogClear}"
                HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
