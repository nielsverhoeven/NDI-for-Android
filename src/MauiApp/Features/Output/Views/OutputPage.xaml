<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NdiForAndroid.Features.Output.ViewModels;assembly=NdiForAndroid.Core"
             xmlns:t="clr-namespace:NdiForAndroid.Testing;assembly=NdiForAndroid.Core"
             x:Class="NdiForAndroid.Features.Output.Views.OutputPage"
             x:DataType="vm:OutputViewModel"
             AutomationId="{x:Static t:TestIds.OutputPage}"
             Title="Stream">
    <!-- ScrollView keeps the full form reachable in landscape / small windows (#280). -->
    <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="16">

        <!-- Mode toggle. The whole row toggles the mode (#346 OUT-07). The Switch consumes its
             own touches on Android, so the row's TapGestureRecognizer only fires for taps on
             the labels and gaps — no double toggle. -->
        <Frame BackgroundColor="{DynamicResource CardBackground}" BorderColor="{DynamicResource BorderColor}">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center"
                                   MinimumHeightRequest="48"
                                   AutomationId="{x:Static t:TestIds.OutputModeRow}"
                                   SemanticProperties.Description="Output mode: capture or re-stream">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleOutputModeCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="Capture:" VerticalOptions="Center"
                       AutomationId="{x:Static t:TestIds.OutputModeCaptureLabel}" />
                <!-- IsToggled binds the INVERSE of IsReStreamMode: ON means Capture. The name must
                     disclose that (#345 OUT-02) — TalkBack appends role/state itself. -->
                <Switch AutomationId="{x:Static t:TestIds.OutputModeToggle}"
                        IsToggled="{Binding IsReStreamMode, Converter={StaticResource InverseBoolConverter}}"
                        SemanticProperties.Description="Output mode, on for capture, off for re-stream" />
                <Label Text="Re-stream:" VerticalOptions="Center"
                       AutomationId="{x:Static t:TestIds.OutputModeReStreamLabel}" />
            </HorizontalStackLayout>
        </Frame>

        <!-- Stream name -->
        <Label Text="Stream Name" FontAttributes="Bold" />
        <Entry Text="{Binding StreamName}"
               AutomationId="{x:Static t:TestIds.OutputStreamName}"
               Placeholder="NDI-Android"
               IsEnabled="{Binding IsOutputActive, Converter={StaticResource InverseBoolConverter}}" />

        <!-- Video input selection (capture mode only). Wrapped in an input-styled panel with a
             trailing chevron so it reads as a selection control rather than a static label
             (#375): before this, the Picker rendered as plain text over a bare underline, the
             only input in the app without the shared InputBackground panel. -->
        <Label Text="Video Input"
               FontAttributes="Bold"
               IsVisible="{Binding IsReStreamMode, Converter={StaticResource InverseBoolConverter}}" />
        <Border BackgroundColor="{DynamicResource InputBackground}"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 6"
                Padding="12,0"
                IsVisible="{Binding IsReStreamMode, Converter={StaticResource InverseBoolConverter}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Picker Grid.Column="0"
                        AutomationId="{x:Static t:TestIds.OutputVideoInput}"
                        ItemsSource="{Binding AvailableInputKinds}"
                        SelectedItem="{Binding SelectedInputKind}"
                        ItemDisplayBinding="{Binding ., Converter={StaticResource VideoInputKindDisplayConverter}}"
                        IsEnabled="{Binding IsOutputActive, Converter={StaticResource InverseBoolConverter}}"
                        SemanticProperties.Description="Video input" />
                <!-- Decorative dropdown affordance; the accessible name/role lives on the Picker. -->
                <Label Grid.Column="1" Text="&#x25BE;"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource TextSecondary}"
                       AutomationProperties.IsInAccessibleTree="False" />
            </Grid>
        </Border>

        <!-- Microphone audio (capture mode only). Whole row toggles the switch (#346 OUT-07);
             the command's CanExecute mirrors the Switch's IsEnabled (!IsOutputActive). -->
        <HorizontalStackLayout Spacing="8"
                               MinimumHeightRequest="48"
                               AutomationId="{x:Static t:TestIds.OutputMicrophoneRow}"
                               SemanticProperties.Description="Send microphone audio"
                               IsVisible="{Binding IsReStreamMode, Converter={StaticResource InverseBoolConverter}}">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMicrophoneCommand}" />
            </HorizontalStackLayout.GestureRecognizers>
            <Switch AutomationId="{x:Static t:TestIds.OutputMicrophoneToggle}"
                    IsToggled="{Binding CaptureMicrophone}"
                    IsEnabled="{Binding IsOutputActive, Converter={StaticResource InverseBoolConverter}}"
                    SemanticProperties.Description="Send microphone audio" />
            <Label Text="Send microphone audio" VerticalOptions="Center"
                   AutomationId="{x:Static t:TestIds.OutputMicrophoneLabel}" />
        </HorizontalStackLayout>

        <!-- Re-stream source selector (only visible in re-stream mode). Picker is the primary
             control (Nielsen #6, #343 OUT-08): recognition over recall, reusing the Video Input
             Picker's input-panel + chevron treatment above for consistency (Nielsen #4). The
             free-text Entry is kept only as the empty-state fallback (ShowReStreamManualEntry) for
             when no source is cached or discovered yet — the two controls are never both visible. -->
        <Label Text="Re-stream Source"
               FontAttributes="Bold"
               IsVisible="{Binding IsReStreamMode}" />
        <Border BackgroundColor="{DynamicResource InputBackground}"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 6"
                Padding="12,0"
                MinimumHeightRequest="48"
                IsVisible="{Binding ShowReStreamSourcePicker}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Picker Grid.Column="0"
                        Title="Select a source"
                        MinimumHeightRequest="48"
                        AutomationId="{x:Static t:TestIds.OutputReStreamSourcePicker}"
                        ItemsSource="{Binding AvailableReStreamSources}"
                        SelectedItem="{Binding SelectedReStreamSource}"
                        ItemDisplayBinding="{Binding ., Converter={StaticResource NdiSourceDisplayConverter}}"
                        IsEnabled="{Binding IsOutputActive, Converter={StaticResource InverseBoolConverter}}"
                        SemanticProperties.Description="Re-stream source" />
                <!-- Decorative dropdown affordance; the accessible name/role lives on the Picker. -->
                <Label Grid.Column="1" Text="&#x25BE;"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource TextSecondary}"
                       AutomationProperties.IsInAccessibleTree="False" />
            </Grid>
        </Border>
        <Entry Text="{Binding ReStreamSourceId}"
               AutomationId="{x:Static t:TestIds.OutputReStreamSourceId}"
               Placeholder="No discovered sources yet — enter a source id manually"
               MinimumHeightRequest="48"
               IsVisible="{Binding ShowReStreamManualEntry}"
               IsEnabled="{Binding IsOutputActive, Converter={StaticResource InverseBoolConverter}}"
               SemanticProperties.Description="Re-stream source id" />

        <!-- Live status: connection count + program tally -->
        <HorizontalStackLayout Spacing="12"
                               HorizontalOptions="Center"
                               IsVisible="{Binding IsOutputActive}">
            <Label Text="{Binding ConnectionCount, StringFormat='Connections: {0}'}"
                   AutomationId="{x:Static t:TestIds.OutputConnectionCount}"
                   TextColor="{DynamicResource TextSecondary}"
                   VerticalOptions="Center" />
            <Label Text="ON AIR"
                   AutomationId="{x:Static t:TestIds.OutputOnAirTally}"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ErrorText}"
                   IsVisible="{Binding IsOnProgramTally}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Status line (#349, Nielsen #9). Error statuses — validation, declined permission,
             start failure — get the same ErrorText + Bold treatment as the ON AIR tally above,
             plus a warning glyph so the distinction survives a grayscale rendering. Informational
             and success statuses keep the implicit Label style (TextPrimary, regular weight). -->
        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
            <Label Text="&#x26A0;"
                   AutomationId="{x:Static t:TestIds.OutputStatusErrorIcon}"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ErrorText}"
                   IsVisible="{Binding IsStatusError}"
                   AutomationProperties.IsInAccessibleTree="False"
                   VerticalOptions="Center" />
            <Label Text="{Binding StatusMessage}"
                   AutomationId="{x:Static t:TestIds.OutputStatus}"
                   TextColor="{DynamicResource TextPrimary}"
                   VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsStatusError}" Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource ErrorText}" />
                        <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </HorizontalStackLayout>
        <Button Text="Start Output" Command="{Binding StartOutputCommand}"
                AutomationId="{x:Static t:TestIds.OutputStart}"
                IsVisible="{Binding IsOutputActive, Converter={StaticResource InverseBoolConverter}}"
                HeightRequest="48" MinimumHeightRequest="48"
                HorizontalOptions="Center" />
        <Button Text="Stop Output" Command="{Binding StopOutputCommand}"
                AutomationId="{x:Static t:TestIds.OutputStop}"
                IsVisible="{Binding IsOutputActive}"
                HeightRequest="48" MinimumHeightRequest="48"
                HorizontalOptions="Center" />
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
